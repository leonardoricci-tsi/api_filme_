# URL de conexão do MySQL (formato: mysql+pymysql://usuario:senha@host:porta/nome_do_banco)
DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/api_filmes

# Chave da API do TMDB 
TMDB_API_KEY=

# Segredo usado para assinar os JWTs — gere um valor aleatório forte em produção
JWT_SECRET=

# Opcional: tempo de expiração do token de acesso, em minutos
JWT_EXPIRE_MINUTES=60
