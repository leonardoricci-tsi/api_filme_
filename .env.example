# URL de conexão do MySQL (formato: mysql+pymysql://usuario:senha@host:porta/nome_do_banco)
DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/api_filmes

# Chave da API do TMDB 
TMDB_API_KEY=

# Segredo usado para assinar os JWTs — compartilhado entre o catálogo e o
# auth-service (o catálogo só verifica a assinatura, quem emite é o
# auth-service)
JWT_SECRET=

# Opcional: tempo de expiração do token de acesso, em minutos (usado só
# pelo auth-service, que é quem emite o token)
JWT_EXPIRE_MINUTES=60

# Opcional: URL interna do auth-service. No docker-compose já vem setada
# (http://auth-service:8001) — só precisa definir aqui pra rodar o
# catálogo fora do Docker, contra um auth-service local.
AUTH_SERVICE_URL=http://localhost:8001

# Log de auditoria (atividade 5): URL interna do log-service e do Redis
# usado por ele. No docker-compose já vem setada (log-service:8002 /
# redis:6379) — só precisa definir aqui pra rodar fora do Docker.
LOG_SERVICE_URL=http://localhost:8002
REDIS_URL=redis://localhost:6379/0

# SMTP usado pelo auth-service para enviar o e-mail de redefinição de senha.
# Em dev, use um inbox do Mailtrap (mailtrap.io -> Email Testing -> Inboxes
# -> SMTP Settings): SMTP_USER e SMTP_PASSWORD vêm de lá, SMTP_HOST/PORT já
# vêm com o padrão certo (sandbox.smtp.mailtrap.io:587). Em produção, essas
# mesmas variáveis apontariam pro Brevo, sem mudar código.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@catalogo-filmes.local
SMTP_FROM_NAME=Catálogo de Filmes

# URL pública do catálogo — é pra cá que aponta o link de redefinição de
# senha enviado por e-mail. Em dev fica localhost; EM PRODUÇÃO/DEPLOY,
# TROQUE pelo seu subdomínio real (ex: https://api-filmes.seusubdominio.com)
# — senão o link do e-mail aponta pra localhost e não funciona pra ninguém
# além de você.
CATALOG_PUBLIC_URL=http://localhost:8000

# Object storage (atividade 6): Garage, onde ficam as fotos de perfil — o
# MySQL guarda só a chave do objeto. O Garage cria a chave de acesso e o
# bucket sozinho no primeiro boot (`--single-node --default-bucket`) a
# partir destas variáveis. Gere os valores com:
#   GARAGE_RPC_SECRET: openssl rand -hex 32
#   S3_ACCESS_KEY:     echo "GK$(openssl rand -hex 16)"   (formato fixo: GK + 32 hex)
#   S3_SECRET_KEY:     openssl rand -hex 32
GARAGE_RPC_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=api-filmes-perfis
# Endereço interno (catálogo -> Garage). No docker-compose já vem setado
# (http://garage:3900) — só precisa definir aqui pra rodar fora do Docker.
S3_ENDPOINT_URL=http://localhost:3900
# Endereço que o NAVEGADOR usa pra abrir a foto (URL pré-assinada): o do
# PRÓPRIO catálogo, que repassa pro Garage (o Garage não tem porta pública).
# A assinatura inclui esse host, então tem que ser exatamente o endereço
# pelo qual o site é acessado. Em deploy, troque pelo domínio público (ex:
# https://leonardo-oliveira-isw055.lapps.studio).
S3_PUBLIC_URL=http://localhost:8000

# Plano premium (atividade 7): Stripe SEMPRE em modo de teste. Deixar
# vazio desliga o premium (o checkout responde 503), o resto sobe normal.
#   STRIPE_SECRET_KEY: dashboard.stripe.com -> modo de teste -> Developers
#                      -> API keys -> Secret key (sk_test_...)
#   STRIPE_PRICE_ID:   o preço do produto "Plano Premium" (price_...)
#   STRIPE_WEBHOOK_SECRET: em dev, o whsec_... que o `stripe listen` mostra;
#                      em produção, o do endpoint de webhook criado no painel
# O link de volta do checkout usa o CATALOG_PUBLIC_URL (lá em cima).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Observabilidade: senha do admin do Grafana (http://localhost:3000). O
# painel abre sem login (só leitura); a senha só é pedida pra editar.
# Gere com: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
