{
  "openapi": "3.1.0",
  "info": {
    "title": "Log Service — Auditoria",
    "version": "0.1.0"
  },
  "paths": {
    "/logs": {
      "post": {
        "tags": [
          "logs"
        ],
        "summary": "Registrar Evento",
        "description": "Sem autenticação própria: só alcançável de dentro da rede Docker\n(log-service não tem porta publicada pro host), chamado pelo catálogo e\npelo auth-service depois que eles já identificaram o usuário — mesmo\nnível de confiança que o resto da comunicação interna entre serviços.",
        "operationId": "registrar_evento_logs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogEventIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Registrar Evento Logs Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "logs"
        ],
        "summary": "Consultar Eventos",
        "operationId": "consultar_eventos_logs_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LogEventOut"
                  },
                  "title": "Response Consultar Eventos Logs Get"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Credenciais inválidas ou expiradas"
                }
              }
            }
          },
          "403": {
            "description": "Autenticado, mas sem papel admin",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Acesso restrito a admins"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LogEventIn": {
        "properties": {
          "usuario_id": {
            "type": "integer",
            "title": "Usuario Id"
          },
          "acao": {
            "type": "string",
            "title": "Acao"
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip"
          }
        },
        "type": "object",
        "required": [
          "usuario_id",
          "acao"
        ],
        "title": "LogEventIn"
      },
      "LogEventOut": {
        "properties": {
          "usuario_id": {
            "type": "integer",
            "title": "Usuario Id"
          },
          "acao": {
            "type": "string",
            "title": "Acao"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip"
          }
        },
        "type": "object",
        "required": [
          "usuario_id",
          "acao",
          "timestamp"
        ],
        "title": "LogEventOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}